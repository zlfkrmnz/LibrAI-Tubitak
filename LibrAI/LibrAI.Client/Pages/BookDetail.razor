@page "/books/{isbn}"
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Kitap Detayı</PageTitle>

<MudPaper Class="p-6 rounded-xl">
    <MudBreadcrumbs Class="mb-4">
        <MudBreadcrumbItem Href="/">Ana Sayfa</MudBreadcrumbItem>
        <MudBreadcrumbItem Href="/books">Katalog</MudBreadcrumbItem>
        <MudBreadcrumbItem Disabled="true">@(_book?.Title ?? "Detay")</MudBreadcrumbItem>
    </MudBreadcrumbs>

    @if (_loading)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="mb-4" />
        <MudSkeleton SkeletonType="SkeletonType.Text" />
        <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        <MudButton Variant="Variant.Outlined" OnClick="@GoBack" StartIcon="@Icons.Material.Filled.ArrowBack">
            Geri Dön
        </MudButton>
    }
    else if (_book is null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Bu ISBN için kitap bulunamadı.
        </MudAlert>
        <MudButton Variant="Variant.Outlined" OnClick="@GoBack" StartIcon="@Icons.Material.Filled.ArrowBack">
            Geri Dön
        </MudButton>
    }
    else
    {
        <MudGrid GutterSize="GutterSize.Small">
            <MudItem xs="12" md="4">
                <MudCard>
                    <MudCardMedia Image="@_book.CoverUrl" Alt="@_book.Title" Height="360" />
                    <MudCardContent>
                        <div class="flex items-center gap-2">
                            <MudChip T="string"
                                     Color="@(_book.Available ? Color.Success : Color.Error)"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small">
                                @(_book.Available ? "Müsait" : "Ödünçte")
                            </MudChip>
                            @if (!string.IsNullOrWhiteSpace(_book.Isbn))
                            {
                                <MudText Typo="Typo.caption">ISBN: @_book.Isbn</MudText>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h5" Class="font-semibold">@_book.Title</MudText>
                <MudText Typo="Typo.subtitle2" Class="text-secondary mb-2">@_book.Author</MudText>

                <MudStack Row="true" Spacing="2" Class="mb-3">
                    @if (!string.IsNullOrWhiteSpace(_book.Category))
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Category">
                            @_book.Category
                        </MudChip>
                    }
                    @if (!string.IsNullOrWhiteSpace(_book.Publisher))
                    {
                        <MudChip T="string" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.LocalLibrary">
                            @_book.Publisher
                        </MudChip>
                    }
                    @if (_book.Year is not null)
                    {
                        <MudChip T="string" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CalendarToday">
                            @_book.Year
                        </MudChip>
                    }
                    @if (_book.Pages is not null)
                    {
                        <MudChip T="string" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MenuBook">
                            @_book.Pages sayfa
                        </MudChip>
                    }
                    @if (_book.Price is not null)
                    {
                        <MudChip T="string" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachMoney">
                            @_book.Price.Value.ToString("0.##")
                        </MudChip>
                    }
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(_book.Description))
                {
                    <MudText Typo="Typo.body2" Class="mb-4">
                        @_book.Description
                    </MudText>
                }

                <MudStack Row="true" Spacing="2" Class="mb-4">
                    <MudButton Color="Color.Primary" Variant="Variant.Filled"
                               Disabled="@(!_book.Available)"
                               OnClick="@(()=>Borrow(_book!.Id))">
                        Ödünç Al
                    </MudButton>
                    <MudButton Color="Color.Secondary" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.BookmarkAdd">
                        Rezerve Et
                    </MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@GoBack">
                        Geri
                    </MudButton>
                </MudStack>

                @if (_related?.Count > 0)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Benzer Kitaplar</MudText>
                    <MudGrid GutterSize="GutterSize.Small">
                        @foreach (var r in _related)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudCard>
                                    <MudCardMedia Image="@r.CoverUrl" Alt="@r.Title" Height="160" />
                                    <MudCardContent>
                                        <MudText Typo="Typo.subtitle2" Class="line-clamp-2">@r.Title</MudText>
                                        <MudText Typo="Typo.caption" Class="text-secondary">@r.Author</MudText>
                                    </MudCardContent>
                                    <MudCardActions>
                                        <MudButton Variant="Variant.Text"
                                                   Href="@($"/books/{r.Isbn}")"
                                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                                            Detay
                                        </MudButton>
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudItem>
        </MudGrid>
    }
</MudPaper>

@code {
    [Parameter] public string? isbn { get; set; }

    // API DTO’ları (Server tarafındaki BooksController ile uyumlu)
    private record BookDetailDto(
        int Id, string? Title, string? Author, string? Isbn,
        string? Publisher, int? PageCount, string? Language,
        string? Description, string? ImageUrl, DateTime? PublishDate, decimal? Price,
        bool Available
    );

    private record BookListItemDto(int Id, string? Title, string? Author, string? Isbn, string? ImageUrl, bool Available);
    private record PagedResult<T>(IReadOnlyList<T> Items, int Total, int Page, int PageSize);

    // UI modeli
    private record BookVm(
        int Id,
        string Isbn,
        string Title,
        string Author,
        string CoverUrl,
        bool   Available,
        string? Category = null, // şimdilik dto’da yoksa null kalabilir
        string? Publisher = null,
        int?    Year = null,
        int?    Pages = null,
        string? Description = null,
        decimal? Price = null
    );

    private BookVm? _book;
    private List<BookVm> _related = new();
    private bool _loading = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _book = null;
        _related.Clear();

        try
        {
            await LoadBookAsync(isbn);
        }
        catch (HttpRequestException ex)
        {
            _error = $"Sunucuya ulaşılamıyor: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = $"Beklenmeyen bir hata: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadBookAsync(string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            _book = null;
            return;
        }

        // 1) Detay
        var dto = await Http.GetFromJsonAsync<BookDetailDto>($"api/books/{key}");
        if (dto is null)
        {
            _book = null;
            return;
        }

        _book = new BookVm(
            Id: dto.Id,
            Isbn: dto.Isbn ?? "",
            Title: dto.Title ?? "(Başlık yok)",
            Author: dto.Author ?? "(Yazar yok)",
            CoverUrl: string.IsNullOrWhiteSpace(dto.ImageUrl) ? "images/covers/placeholder.jpg" : dto.ImageUrl!,
            Available: dto.Available,
            Category: null,                              // İstersen Server DTO’ya Category ekleyebiliriz
            Publisher: dto.Publisher,
            Year: dto.PublishDate?.Year,
            Pages: dto.PageCount,
            Description: dto.Description,
            Price: dto.Price
        );

        // 2) Benzerler — önce yazara göre, yoksa başlığa göre arayalım
        var related = new List<BookVm>();

        if (!string.IsNullOrWhiteSpace(dto.Author))
        {
            var relByAuthor = await Http.GetFromJsonAsync<PagedResult<BookListItemDto>>(
                $"api/books?filter=author&q={Uri.EscapeDataString(dto.Author)}&page=1&pageSize=6");

            if (relByAuthor?.Items is not null)
            {
                related.AddRange(relByAuthor.Items
                    .Where(x => !string.Equals(x.Isbn, dto.Isbn, StringComparison.OrdinalIgnoreCase))
                    .Select(x => new BookVm(
                        Id: x.Id,
                        Isbn: x.Isbn ?? "",
                        Title: x.Title ?? "(Başlık yok)",
                        Author: x.Author ?? "(Yazar yok)",
                        CoverUrl: string.IsNullOrWhiteSpace(x.ImageUrl) ? "images/covers/placeholder.jpg" : x.ImageUrl!,
                        Available: x.Available
                    )));
            }
        }

        if (related.Count < 3 && !string.IsNullOrWhiteSpace(dto.Title))
        {
            var relByTitle = await Http.GetFromJsonAsync<PagedResult<BookListItemDto>>(
                $"api/books?filter=title&q={Uri.EscapeDataString(dto.Title)}&page=1&pageSize=6");

            if (relByTitle?.Items is not null)
            {
                related.AddRange(relByTitle.Items
                    .Where(x => !string.Equals(x.Isbn, dto.Isbn, StringComparison.OrdinalIgnoreCase))
                    .Select(x => new BookVm(
                        Id: x.Id,
                        Isbn: x.Isbn ?? "",
                        Title: x.Title ?? "(Başlık yok)",
                        Author: x.Author ?? "(Yazar yok)",
                        CoverUrl: string.IsNullOrWhiteSpace(x.ImageUrl) ? "images/covers/placeholder.jpg" : x.ImageUrl!,
                        Available: x.Available
                    )));
            }
        }

        _related = related
            .GroupBy(x => x.Isbn)     // tekrarları temizle
            .Select(g => g.First())
            .Take(6)
            .ToList();
    }

    private async Task Borrow(int bookId)
    {
        var res = await Http.PostAsync($"api/loans/borrow/{bookId}", null);
        if (res.IsSuccessStatusCode)
        {
            // mevcut ISBN üzerinden tekrar yükle
            await LoadBookAsync(isbn);
            StateHasChanged();
        }
}

    private void GoBack() => Navigation.NavigateTo("/books");
}

@page "/login"
@inject AuthClient Auth
@inject NavigationManager Nav

<MudPaper Class="p-6 max-w-md mx-auto rounded-xl">
    <MudText Typo="Typo.h5" Class="mb-4">Giriş Yap</MudText>
    <EditForm Model="_m" OnValidSubmit="OnSubmit">
        <MudTextField @bind-Value="_m.Email" Label="Email" Required="true" />
        <MudTextField @bind-Value="_m.Password" Label="Şifre" InputType="InputType.Password" Required="true" Class="mt-2" />
        <MudButton Class="mt-4" Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="OnSubmit">Giriş</MudButton>
    </EditForm>
    @if (!string.IsNullOrEmpty(_err))
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_err</MudAlert>
    }
</MudPaper>

@code {
    private M _m = new();
    private bool _busy;
    private string? _err;
    private class M { public string Email { get; set; } = ""; public string Password { get; set; } = ""; }

    private async Task OnSubmit()
    {
        _busy = true; _err = null;
        if (await Auth.LoginAsync(_m.Email, _m.Password))
            Nav.NavigateTo("/");
        else
            _err = "Giriş başarısız.";
        _busy = false;
    }
}
